# Chave pública do Turnstile (Cloudflare → Turnstile). Vazia = widget desligado.
# No CI ela vem da variable PUBLIC_TURNSTILE_SITE_KEY do repositório.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEuARDNOJrB3YFDu

# Só na Cloudflare Pages (projeto eduardotorresdev → Settings → Environment variables),
# usadas em runtime por functions/api/contact.ts. Já configuradas:
# RESEND_API_KEY=      (secret)
# CONTACT_TO=contato@eduardotorres.dev
# CONTACT_FROM=site@eduardotorres.dev
# TURNSTILE_SECRET=    (secret)
